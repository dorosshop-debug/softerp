# Dependencias
/vendor/
/node_modules/
/build/

# Entorno
.env
.env.*
!.env.example

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# IDE / Cursor
.vscode/
.idea/
.cursor/
*.sublime-workspace
*.sublime-project

# Storage (logs, cache, sesiones, backups)
/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/backups/*
/storage/installed.lock
/storage/app.key
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/sessions/.gitkeep
!/storage/backups/.gitkeep

# Base de datos
*.sqlite
*.db

# Uploads de usuarios
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/avatars/
/public/uploads/avatars/*
!/public/uploads/avatars/.htaccess
!/public/uploads/avatars/.gitkeep
!/public/uploads/branding/
/public/uploads/branding/*
!/public/uploads/branding/.htaccess
!/public/uploads/branding/.gitkeep

# Composer
# composer.lock debe versionarse para consistencia (NO ignorar)

# OS
*.log
error_log
